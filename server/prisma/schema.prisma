generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ProxyMode {
  DIRECT // Standard HTTP proxy (existing behavior)
  HEADLESS // Playwright rendering for WAF-protected sites
  NEW_WINDOW // Open in new tab with logged redirect
}

enum AuditLevel {
  STANDARD // Access only
  NAVIGATION // Include navigation path
  FULL // Include all interactions
}

enum Role {
  USER
  TEAM_LEAD
  ADMIN
}

enum DocumentTypeCategory {
  GOVT
  CUSTOM
}

enum GovtDocumentCode {
  AADHAR
  PAN
  DL
  PASSPORT
  VOTER_ID
  RATION_CARD
}

enum ScanTarget {
  FOLDER
  FILE
}

enum ValidationStatus {
  PENDING
  IN_PROGRESS
  PASSED
  DOUBTFUL
  FAILED
  DOCS_NOT_AVAILABLE
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Project {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)

  categories        Category[]
  urlConfigurations UrlConfiguration[]
  userAssignments   UserAssignment[]
  auditLogs         AuditLog[]

  @@map("projects")
}

model User {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  username            String    @unique @db.VarChar(100)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(200)
  role                Role      @default(USER)
  status              Status    @default(ACTIVE)
  forcePasswordChange Boolean   @default(true) @map("force_password_change")
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.VarChar(36)
  updatedBy           String?   @map("updated_by") @db.VarChar(36)

  assignments      UserAssignment[]
  subCategoryAccess UserSubCategory[]
  sessions         Session[]
  auditLogs        AuditLog[]
  proxyMetrics     ProxyMetric[]
  assignedClaims   Claim[]          @relation("ClaimAssignee")
  authoredRemarks  ClaimRemark[]    @relation("ClaimRemarkAuthor")
  claimAuditLogs   ClaimAuditLog[]

  @@map("users")
}

model UserAssignment {
  id            String @id @default(uuid()) @db.VarChar(36)
  userId        String @map("user_id") @db.VarChar(36)
  projectId String @map("project_id") @db.VarChar(36)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId])
  @@map("user_assignments")
}

// Granular per-user access: the specific SubCategories a user may see within
// their assigned Project. Drives proxy menu/URL access AND Claims scope.
model UserSubCategory {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @map("user_id") @db.VarChar(36)
  subCategoryId String   @map("sub_category_id") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, subCategoryId])
  @@index([subCategoryId])
  @@map("user_sub_categories")
}

model Category {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(100)
  projectId String   @map("project_id") @db.VarChar(36)
  description   String?  @db.VarChar(500)
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by") @db.VarChar(36)
  updatedBy     String?  @map("updated_by") @db.VarChar(36)

  project       Project        @relation(fields: [projectId], references: [id])
  subCategories     SubCategory[]
  urlConfigurations UrlConfiguration[]

  @@unique([name, projectId])
  @@map("categories")
}

model SubCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  categoryId  String   @map("category_id") @db.VarChar(36)
  description String?  @db.VarChar(500)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)

  category          Category           @relation(fields: [categoryId], references: [id])
  urlConfigurations UrlConfiguration[]
  claimIdRule       ClaimIdRule?
  claims            Claim[]
  scanJobs          ScanJob[]
  userAccess        UserSubCategory[]

  @@unique([name, categoryId])
  @@map("sub_categories")
}

model UrlConfiguration {
  id            String   @id @default(uuid()) @db.VarChar(36)
  label         String   @db.VarChar(200)
  description   String?  @db.VarChar(500)
  targetUrl     String   @map("target_url") @db.VarChar(2000)
  opaqueId      String   @unique @default(uuid()) @map("opaque_id") @db.VarChar(36)
  projectId String   @map("project_id") @db.VarChar(36)
  categoryId    String   @map("category_id") @db.VarChar(36)
  subCategoryId String   @map("sub_category_id") @db.VarChar(36)
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by") @db.VarChar(36)
  updatedBy     String?  @map("updated_by") @db.VarChar(36)

  // Proxy mode configuration
  proxyMode       ProxyMode  @default(DIRECT) @map("proxy_mode")
  headlessTimeout Int        @default(60000) @map("headless_timeout") // ms, default 60s
  sessionTtl      Int        @default(30000) @map("session_ttl") // ms, default 30s idle
  auditLevel      AuditLevel @default(STANDARD) @map("audit_level")

  project  Project   @relation(fields: [projectId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  subCategory  SubCategory   @relation(fields: [subCategoryId], references: [id])
  auditLogs    AuditLog[]
  proxyMetrics ProxyMetric[]

  @@map("url_configurations")
}

model Session {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  sessionToken   String   @unique @map("session_token") @db.VarChar(64)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  lastActivity   DateTime @default(now()) @map("last_activity")
  impersonatedBy String?  @map("impersonated_by") @db.VarChar(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  projectId  String   @map("project_id") @db.VarChar(36)
  urlConfigId    String   @map("url_config_id") @db.VarChar(36)
  targetUrl      String   @map("target_url") @db.VarChar(2000)
  requestMethod  String   @map("request_method") @db.VarChar(10)
  responseStatus Int      @map("response_status")
  durationMs     Int      @map("duration_ms")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  accessedAt     DateTime @default(now()) @map("accessed_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id])
  urlConfig   UrlConfiguration @relation(fields: [urlConfigId], references: [id])

  @@index([userId])
  @@index([accessedAt])
  @@index([projectId])
  @@map("audit_logs")
}

// What a claim audit row records. Bulk and single share one table: a single delete is a
// bulk of one, and a reviewer asking "who removed this claim" should not have to know
// which button was pressed to find the answer.
enum ClaimAuditAction {
  BULK_VALIDATE
  BULK_REMARK
  BULK_DELETE
  BULK_RESTORE
  DELETE
  RESTORE
}

// How a bulk call named its targets. Worth recording on its own: "deleted 31 claims by
// ticking them" and "deleted every claim matching an empty filter" look identical once
// only the resulting ids are kept, and they are very different mistakes.
enum ClaimAuditTargeting {
  IDS
  FILTERS
  SINGLE
}

// One row per claim lifecycle action, written after the action runs. The per-claim
// ClaimRemark trail says WHAT happened to a claim; this says who ran the call, how they
// aimed it, and which claims went with it — the correlation that otherwise only exists as
// "these 31 rows share an updated_at to the second".
//
// Deliberately NOT the AuditLog table above: that one is the proxy's, and every one of its
// columns (urlConfigId, targetUrl, responseStatus) is required and meaningless here.
model ClaimAuditLog {
  id        String              @id @default(uuid()) @db.VarChar(36)
  userId    String              @map("user_id") @db.VarChar(36)
  action    ClaimAuditAction
  targeting ClaimAuditTargeting
  /// The filters the call was aimed with, when it was aimed by filters. Null for an
  /// explicit selection — there the ids ARE the intent.
  filters   Json?
  /// The claims the call was aimed at. Capped at BULK_MAX (500) upstream, so bounded.
  claimIds  Json                @map("claim_ids")
  /// The per-claim refusals, as {id, code}. Null when nothing failed. Without it a row
  /// saying "31 of 35" cannot say WHICH four did not change.
  failures  Json?
  requested Int
  succeeded Int
  failed    Int
  ipAddress String?             @map("ip_address") @db.VarChar(45)
  createdAt DateTime            @default(now()) @map("created_at")

  // No onDelete: Cascade, unlike AuditLog — deleting a user must not erase the record of
  // what they did. That makes this a RESTRICT, and DELETE /api/admin/users/:id is a hard
  // delete, so the route checks for rows here first and answers 409 pointing at
  // deactivation. Without that check the constraint surfaced as a 500.
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("claim_audit_logs")
}

model Setting {
  id    String @id @default(uuid()) @db.VarChar(36)
  key   String @unique @db.VarChar(100)
  value String @db.VarChar(1000)

  @@map("settings")
}

model ProxyMetric {
  id          String    @id @default(uuid()) @db.VarChar(36)
  urlConfigId String    @map("url_config_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  sessionId   String    @map("session_id") @db.VarChar(64) // ProxyURLApp session token
  proxyMode   ProxyMode @map("proxy_mode")

  // Timing metrics
  startTime  DateTime  @map("start_time")
  endTime    DateTime? @map("end_time")
  durationMs Int?      @map("duration_ms")

  // Performance metrics
  ttfbMs    Int? @map("ttfb_ms") // Time to first byte
  domLoadMs Int? @map("dom_load_ms") // DOM content loaded

  // Status
  success      Boolean @default(true)
  errorCode    String? @map("error_code") @db.VarChar(50)
  errorMessage String? @map("error_message") @db.Text

  // Request details
  targetUrl        String @map("target_url") @db.VarChar(2000)
  httpStatus       Int?   @map("http_status")
  bytesTransferred Int?   @map("bytes_transferred")

  // Headless-specific metrics
  browserSpawnMs Int? @map("browser_spawn_ms") // Time to spawn browser
  queueWaitMs    Int? @map("queue_wait_ms") // Time spent in queue

  createdAt DateTime @default(now()) @map("created_at")

  urlConfig UrlConfiguration @relation(fields: [urlConfigId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([urlConfigId])
  @@index([userId])
  @@index([startTime])
  @@index([proxyMode])
  @@map("proxy_metrics")
}

model StatusMaster {
  id           String   @id @default(uuid()) @db.VarChar(36)
  name         String   @unique @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  isDefault    Boolean  @default(false) @map("is_default")
  isTerminal   Boolean  @default(false) @map("is_terminal")
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.VarChar(36)
  updatedBy    String?  @map("updated_by") @db.VarChar(36)

  claims              Claim[]       @relation("ClaimWorkflowStatus")
  remarksStatusBefore ClaimRemark[] @relation("ClaimRemarkStatusBefore")
  remarksStatusAfter  ClaimRemark[] @relation("ClaimRemarkStatusAfter")

  @@map("status_masters")
}

model DocumentTypeMaster {
  id           String               @id @default(uuid()) @db.VarChar(36)
  name         String               @unique @db.VarChar(100)
  category     DocumentTypeCategory
  govtCode     GovtDocumentCode?    @unique @map("govt_code")
  displayOrder Int                  @default(0) @map("display_order")
  // Must a claim carry this type to pass FULL validation?
  //
  // Defaults to FALSE. It defaulted to true, which meant every type ever added became
  // mandatory for EVERY claim without anyone choosing it — a production claim read
  // "3 of 9 required document types present" and failed Full Scan while carrying exactly
  // the documents it should. A type is required only when someone ticks it.
  isRequired   Boolean              @default(false) @map("is_required")
  status       Status               @default(ACTIVE)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  createdBy    String?              @map("created_by") @db.VarChar(36)
  updatedBy    String?              @map("updated_by") @db.VarChar(36)

  documents Document[]

  @@map("document_type_masters")
}

/// Expected-vocabulary the SPELL validator checks document text against: a token
/// that is a near-miss of an ACTIVE term (but not itself a real word) is flagged as
/// a misspelling. Holds domain vocab (salary-slip / ID-card words) AND a gazetteer
/// of proper nouns (brands, orgs, places) whose misspellings reviewers flag. Admin-
/// managed so the list can grow without a deploy; seeded from logic.EXPECTED_TERMS.
model SpellTerm {
  id        String   @id @default(uuid()) @db.VarChar(36)
  term      String   @unique @db.VarChar(100)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.VarChar(36)
  updatedBy String?  @map("updated_by") @db.VarChar(36)

  @@map("spell_terms")
}

model ClaimIdRule {
  id            String     @id @default(uuid()) @db.VarChar(36)
  subCategoryId String     @unique @map("sub_category_id") @db.VarChar(36)
  startPosition Int        @map("start_position")
  length        Int
  scanTarget    ScanTarget @map("scan_target")
  scanLocation  String     @map("scan_location") @db.VarChar(500)
  status        Status     @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  createdBy     String?    @map("created_by") @db.VarChar(36)
  updatedBy     String?    @map("updated_by") @db.VarChar(36)

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  scanJobs    ScanJob[]

  @@map("claim_id_rules")
}

model Claim {
  id               String  @id @default(uuid()) @db.VarChar(36)
  claimId          String  @map("claim_id") @db.VarChar(100)
  subCategoryId    String  @map("sub_category_id") @db.VarChar(36)
  workflowStatusId String  @map("workflow_status_id") @db.VarChar(36)
  assignedToUserId String? @map("assigned_to_user_id") @db.VarChar(36)
  folderPath       String? @map("folder_path") @db.VarChar(500)

  // Business metadata captured from the "Forged Documents Observations" upload sheet.
  // All optional so existing/scan-discovered claims remain valid.
  dealerName         String?   @map("dealer_name") @db.VarChar(255)
  dealerCode         String?   @map("dealer_code") @db.VarChar(50)
  invoiceDate        DateTime? @map("invoice_date")
  vinNo              String?   @map("vin_no") @db.VarChar(100)
  customerName       String?   @map("customer_name") @db.VarChar(255)
  schemeType         String?   @map("scheme_type") @db.VarChar(100)
  observationRemarks String?   @map("observation_remarks") @db.Text

  spellCheckStatus     ValidationStatus @default(PENDING) @map("spell_check_status")
  qrStatus             ValidationStatus @default(PENDING) @map("qr_status")
  metaExtractionStatus ValidationStatus @default(PENDING) @map("meta_extraction_status")
  intraClaimStatus     ValidationStatus @default(PENDING) @map("intra_claim_status")
  fullScanStatus       ValidationStatus @default(PENDING) @map("full_scan_status")
  redFlagStatus        ValidationStatus @default(PENDING) @map("red_flag_status")

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.VarChar(36)
  updatedBy String?  @map("updated_by") @db.VarChar(36)

  subCategory       SubCategory        @relation(fields: [subCategoryId], references: [id])
  workflowStatus    StatusMaster       @relation("ClaimWorkflowStatus", fields: [workflowStatusId], references: [id])
  assignedTo        User?              @relation("ClaimAssignee", fields: [assignedToUserId], references: [id])
  remarks           ClaimRemark[]
  documents         Document[]
  validationRuns    ValidationRun[]
  validationResults ValidationResult[]

  @@unique([claimId, subCategoryId])
  @@index([subCategoryId])
  @@index([workflowStatusId])
  @@index([assignedToUserId])
  @@index([createdBy])
  // The list orders by createdAt with an id tiebreak, and the document viewer's step arrows
  // walk that same order as a keyset range — without this both are a full scan plus filesort.
  @@index([status, createdAt, id])
  @@map("claims")
}

model ClaimRemark {
  id             String   @id @default(uuid()) @db.VarChar(36)
  claimId        String   @map("claim_id") @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  remarkText     String   @map("remark_text") @db.Text
  statusBeforeId String?  @map("status_before_id") @db.VarChar(36)
  statusAfterId  String?  @map("status_after_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at")

  claim        Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  user         User          @relation("ClaimRemarkAuthor", fields: [userId], references: [id])
  statusBefore StatusMaster? @relation("ClaimRemarkStatusBefore", fields: [statusBeforeId], references: [id])
  statusAfter  StatusMaster? @relation("ClaimRemarkStatusAfter", fields: [statusAfterId], references: [id])

  @@index([claimId])
  @@index([createdAt])
  @@map("claim_remarks")
}

model ScanJob {
  id            String        @id @default(uuid()) @db.VarChar(36)
  claimIdRuleId String        @map("claim_id_rule_id") @db.VarChar(36)
  subCategoryId String        @map("sub_category_id") @db.VarChar(36)
  status        ScanJobStatus @default(QUEUED)

  scanLocation String     @map("scan_location") @db.VarChar(500)
  scanTarget   ScanTarget @map("scan_target")

  totalEntries Int     @default(0) @map("total_entries")
  createdCount Int     @default(0) @map("created_count")
  skippedCount Int     @default(0) @map("skipped_count")
  errorCount   Int     @default(0) @map("error_count")
  docsCreated  Int     @default(0) @map("docs_created")
  docsSkipped  Int     @default(0) @map("docs_skipped")
  errors       Json?
  message      String? @db.VarChar(500)

  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  triggeredBy String?   @map("triggered_by") @db.VarChar(36)

  claimIdRule ClaimIdRule @relation(fields: [claimIdRuleId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])

  @@index([subCategoryId])
  @@index([claimIdRuleId])
  @@index([status])
  @@map("scan_jobs")
}

enum DocumentSource {
  SCANNED
  UPLOADED
}

enum ValidationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ValidationTrigger {
  AUTO
  MANUAL
}

enum RuleField {
  DOCUMENT_COUNT
  REMARK_COUNT
  ASSIGNED
  HAS_DOCUMENT_TYPE
  WORKFLOW_STATUS
  SPELL_STATUS
  QR_STATUS
  META_STATUS
  INTRA_STATUS
  FULL_STATUS
}

enum RuleOperator {
  EQ
  NEQ
  GTE
  LTE
  GT
  LT
}

model Document {
  id             String         @id @default(uuid()) @db.VarChar(36)
  claimId        String         @map("claim_id") @db.VarChar(36)
  documentTypeId String?        @map("document_type_id") @db.VarChar(36)
  source         DocumentSource
  fileName       String         @map("file_name") @db.VarChar(500)
  storagePath    String         @map("storage_path") @db.VarChar(500)
  sizeBytes      Int?           @map("size_bytes")
  mimeType       String?        @map("mime_type") @db.VarChar(150)
  createdAt      DateTime       @default(now()) @map("created_at")
  createdBy      String?        @map("created_by") @db.VarChar(36)

  claim        Claim               @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentType DocumentTypeMaster? @relation(fields: [documentTypeId], references: [id])
  findings     ValidationFinding[]

  @@unique([claimId, storagePath])
  @@index([claimId])
  @@index([documentTypeId])
  @@map("documents")
}

model ValidationRun {
  id          String              @id @default(uuid()) @db.VarChar(36)
  claimId     String              @map("claim_id") @db.VarChar(36)
  status      ValidationRunStatus @default(QUEUED)
  trigger     ValidationTrigger
  startedAt   DateTime?           @map("started_at")
  finishedAt  DateTime?           @map("finished_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  triggeredBy String?             @map("triggered_by") @db.VarChar(36)
  message     String?             @db.VarChar(500)

  claim   Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  results ValidationResult[]

  @@index([claimId])
  // The drainer picks the oldest QUEUED run one at a time; bulk validate can queue hundreds,
  // and on a status-only index each pick filesorts the whole queued set. That older
  // single-column index was a strict left prefix of this one — dropped, because keeping it
  // only added an index rewrite to every QUEUED -> RUNNING -> PASSED transition.
  @@index([status, createdAt])
  @@map("validation_runs")
}

model ValidationResult {
  id           String           @id @default(uuid()) @db.VarChar(36)
  runId        String           @map("run_id") @db.VarChar(36)
  claimId      String           @map("claim_id") @db.VarChar(36)
  validatorKey String           @map("validator_key") @db.VarChar(20)
  status       ValidationStatus
  summary      String?          @db.VarChar(500)
  details      Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  run      ValidationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  claim    Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  findings ValidationFinding[]

  @@index([claimId])
  @@index([runId])
  @@map("validation_results")
}

enum FindingSeverity {
  INFO
  WARNING
  ERROR
}

/// One row per evidence occurrence for a failed (or noteworthy) validation check,
/// attributed to a specific Document when possible. page/bbox stay null until the
/// coordinate-capture phases; the viewer uses them to draw highlight overlays.
model ValidationFinding {
  id           String          @id @default(uuid()) @db.VarChar(36)
  resultId     String          @map("result_id") @db.VarChar(36)
  claimId      String          @map("claim_id") @db.VarChar(36)
  validatorKey String          @map("validator_key") @db.VarChar(20)
  documentId   String?         @map("document_id") @db.VarChar(36)
  code         String          @db.VarChar(40)
  severity     FindingSeverity @default(WARNING)
  message      String          @db.VarChar(500)
  page         Int?
  bbox         Json?
  data         Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  result   ValidationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  document Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([resultId])
  @@index([claimId])
  @@index([documentId, page])
  @@map("validation_findings")
}

model ClaimRule {
  id           String       @id @default(uuid()) @db.VarChar(36)
  name         String       @unique @db.VarChar(150)
  field        RuleField
  operator     RuleOperator
  value        String       @db.VarChar(150)
  status       Status       @default(ACTIVE)
  displayOrder Int          @default(0) @map("display_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  createdBy    String?      @map("created_by") @db.VarChar(36)
  updatedBy    String?      @map("updated_by") @db.VarChar(36)

  @@map("claim_rules")
}
