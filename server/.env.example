# Database
DATABASE_URL="mysql://root:@localhost:3306/proxyapp_db"

# Session
SESSION_SECRET="your-super-secret-session-key-change-in-production"
# Idle timeout, refreshed on every request (and the session cookie tracks it). 8 hours.
SESSION_MAX_AGE_MS=28800000
# Concurrent sessions one account may hold. Past this the least recently active is evicted.
SESSION_MAX_PER_USER=3

# Server
PORT=3001
NODE_ENV=development

# Admin Seed (used by db:seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_FULLNAME=System Administrator

# bcrypt
BCRYPT_ROUNDS=12

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Workflow status a claim moves to the first time validation completes, matched by name
# against an ACTIVE, non-terminal StatusMaster. Defaults to "In Progress". A claim only
# ever moves OFF the default status, never onward, and never to a terminal one.
VALIDATION_ADVANCE_STATUS="In Progress"

# How many validation runs execute at once. Default 2. The ceiling is MEMORY, not CPU: the
# QR high-resolution retry rasterises pages at ~4760x6736, several at a time. Raise with the
# box's RAM in view.
VALIDATION_CONCURRENCY=2
