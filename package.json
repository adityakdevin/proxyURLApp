{
  "name": "proxy-url-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "restart": "npm run restart --workspace=server",
    "stop": "npm run stop --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:seed:demo": "npm run db:seed:demo --workspace=server",
    "db:seed:e2e": "npm run db:seed:e2e --workspace=server",
    "db:reset-admin": "npm run db:reset-admin --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "db:backup": "npm run db:backup --workspace=server",
    "test": "npm run test --workspace=server",
    "test:e2e:api": "npm run test:e2e:api --workspace=server",
    "test:e2e:ui": "npm run db:seed:e2e && playwright test",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:ui",
    "lint": "npm run lint --workspaces",
    "deploy": "npm run db:generate && npm run db:push && npm run build",
    "redeploy": "pm2 stop proxyurl-server && npm run deploy && pm2 restart proxyurl-server"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
